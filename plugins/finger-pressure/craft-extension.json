{
  "schema": 1,
  "id": "io.github.artcraftandroid.finger-pressure",
  "name": "Finger pressure",
  "version": "1.0.0",
  "holds": ["hooks"],
  "publisher": { "name": "ProCraft" },
  "description": "Gives your finger a pressure, as a pen has: the faster it moves the lighter it presses, and each stroke tapers in and out. Pens and mice draw as they do.",
  "compat": { "procraft": { "interface": 9 } },
  "permissions": [],
  "hooks": ["pressure"],
  "controls": [
    {
      "key": "speed", "type": "slider", "label": "Speed influence", "least": 0, "most": 1, "step": 0.01, "starts": 0.7,
      "shown_times": 100, "unit": "%"
    },
    {
      "key": "start", "type": "slider", "label": "Start taper", "least": 0, "most": 200, "step": 1, "starts": 20,
      "unit": " pt", "at_least": "Off"
    },
    {
      "key": "end", "type": "slider", "label": "End taper", "least": 0, "most": 200, "step": 1, "starts": 40,
      "unit": " pt", "at_least": "Off"
    },
    {
      "key": "least", "type": "slider", "label": "Least pressure", "least": 0, "most": 1, "step": 0.01, "starts": 0.1,
      "shown_times": 100, "unit": "%"
    },
    {
      "key": "most", "type": "slider", "label": "Most pressure", "least": 0, "most": 1, "step": 0.01, "starts": 1,
      "shown_times": 100, "unit": "%"
    }
  ]
}
